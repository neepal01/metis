                    "partialFingerprints": {
                        "primaryLocationLineHash": "0c9e147c9d397afd44abbbd04948e8f20bf61702e5ee2aec553212540cb18f34",
                        "metisAnchor/v1": "c477b19a7aa7638a7263a8dad78c54861684400f90442aaec9d69a49451adf46"
