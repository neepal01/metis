                                    "startLine": 97,
                                    "endLine": 117,
                                    "snippet": {
                                        "text": "if ((sid == TFM_CRYPTO_AEAD_ENCRYPT_SETUP_SID) ||\n        (sid == TFM_CRYPTO_AEAD_DECRYPT_SETUP_SID)) {\n        p_handle = out_vec[0].base;\n        if ((out_vec[0].base == NULL) || (out_vec[0].len < sizeof(uint32_t))) {\n            return PSA_ERROR_PROGRAMMER_ERROR;\n        }\n        *p_handle = iov->op_handle;\n        status = tfm_crypto_operation_alloc(TFM_CRYPTO_AEAD_OPERATION,\n                                            out_vec[0].base,\n                                            (void **)&operation);\n...\n    case TFM_CRYPTO_AEAD_ENCRYPT_SETUP_SID:\n    {\n        status = psa_aead_encrypt_setup(operation, library_key, iov->alg);\n        if (status != PSA_SUCCESS) {\n            goto release_operation_and_return;\n        }\n    }\n...\nrelease_operation_and_return:\n    /* Release the operation context, ignore if the operation fails. */\n    (void)tfm_crypto_operation_release(p_handle);\n    return status;"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 94,
                                    "endLine": 100,
                                    "snippet": {
                                        "text": "                                  additional_data, additional_data_length,\n                                  ciphertext, ciphertext_length,\n                                  plaintext, plaintext_size, &out_vec[0].len);\n        if (status != PSA_SUCCESS) {\n            out_vec[0].len = 0;\n        }\n        return status;"
                                    }
                                }
                            }
                        }
                    ],
                    "partialFingerprints": {
                        "primaryLocationLineHash": "33d43577116fcfa394ec00e07d40c6129b44437f9ea3776118841f917576cf90",
                        "metisAnchor/v1": "95134ce166f2fecf774ea00d3d033c9b6d2c94d22b67e09f18a61fd5a03abe9a"
